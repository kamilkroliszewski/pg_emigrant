source:
  host: localhost
  port: 5432
  user: migrator
  password: CHANGE_ME
  dbname: postgres

target:
  host: localhost
  port: 5433
  user: migrator
  password: CHANGE_ME
  dbname: postgres

# Leave empty to auto-discover every non-system schema, independently per
# database (recommended — avoids silently skipping a schema you forgot to
# list, e.g. one that isn't "public"). Use exclude_schemas below to opt
# specific ones back out instead of hand-listing every schema to include.
schemas: []

exclude_schemas: []

# Leave empty to auto-discover all non-system databases
databases: []

exclude_databases:
  - template0
  - template1
  - postgres

publication_name: pg_emigrant_pub
# The replication slot on the source is named after the subscription, one per
# database: <subscription_name>_<database>. There is no separate slot-name
# setting — bootstrap creates the slot first (to copy from its exported
# snapshot) and then attaches the subscription to it by that exact name.
subscription_name: pg_emigrant_sub

# Tables to leave out of the migration entirely: not created on the target,
# not copied, not published, not replicated, and not reported as drift.
# Entries are "schema.table" (fnmatch globs allowed in either half) or a bare
# "table" name, which matches that table in any migrated schema.
#
# An excluded table's data never reaches the target, so the target is
# knowingly not a faithful copy. pg_emigrant refuses to exclude a table that a
# migrated table references by foreign key, because the target's constraint
# could never be satisfied.
exclude_tables: []

parallel_workers: 4
sequence_sync_interval: 10

# ── Web GUI (`pg_emigrant web`) ───────────────────────────────────────────────
# Ignored by every other command. Remove this whole block to run the GUI with
# no login, as it behaved before this section existed — it will say so loudly
# on every start.
web:
  auth:
    # Omit `enabled` and authentication turns itself on as soon as a credential
    # is set below. Set it to false to keep the GUI open with a credential still
    # in the file; set it to true to make the requirement explicit — in which
    # case a missing credential is a startup error, not a silently open GUI.
    # enabled: true

    username: admin

    # Preferred. Generate with:  pg_emigrant hash-password
    password_hash: "REPLACE_ME"

    # Plaintext alternative to password_hash. Accepted because this file already
    # holds database passwords, but a hash costs one command — prefer the above.
    # password: CHANGE_ME

    # Signs the session cookie. Left empty, a random key is generated at every
    # start, so restarting the GUI logs everyone out. Set it to any long random
    # string to keep sessions across restarts.
    # secret_key: ""

    # Idle timeout, refreshed on each request (default 720 = 12 h).
    # session_timeout_minutes: 720

    # Set to true when serving over HTTPS behind a TLS-terminating proxy: marks
    # the session cookie Secure so it is never sent over plain HTTP.
    # cookie_secure: false

    # Failed logins per client address before that address is refused for
    # lockout_seconds. Set max_attempts to 0 to disable the throttle.
    # max_attempts: 5
    # lockout_seconds: 300
